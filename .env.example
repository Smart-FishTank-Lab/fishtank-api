
# ==========================================
# Smart-FishTank-Lab
# 智慧魚缸後端環境變數設定範本
# ==========================================

# API 驗證金鑰
API_KEY=

# MongoDB Atlas 資料庫連線
MONGO_URI=

# MQTT Broker 連線設定
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=

# 魚缸裝置識別名稱
MQTT_DEVICE_ID=fish_Tank_001

# Firebase Admin SDK
# 填入服務帳戶 JSON 憑證檔案路徑
GOOGLE_APPLICATION_CREDENTIALS=

# 原 Render 環境變數，保留供交接時確認
FIREBASE_SERVICE_ACCOUNT_JSON=

# 系統時區
TZ=Asia/Taipei
